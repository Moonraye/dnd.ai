{
  "name": "dnd.ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run start:dev -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "build": "npm run build -w packages/shared && npm run build --workspaces --if-present",
    "test:client": "npm run test -w client",
    "test:server": "npm run test -w server",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint:ci -w server && npm run lint -w client"
  }
}
